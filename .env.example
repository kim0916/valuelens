# 이 파일은 "예시"입니다. 실제 키를 여기 적지 마세요.
# 로컬에서 테스트하려면 이 파일을 복사해 .env 파일을 만들고 값을 채우세요.
# 배포(Vercel)에서는 이 값들을 Vercel 대시보드의 Environment Variables 에 넣습니다.

# Anthropic API 키 (AI 분석용) — https://console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Finnhub API 키 (미국 주식 실시간 가격) — https://finnhub.io 무료 가입 후 발급
FINNHUB_API_KEY=xxxxxxxxxxxxxxxx
